generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String?
  role          String    @default("USER") // ADMIN, USER
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  profile       Profile?
  bookmarks     Bookmark[]
  history       ReadingHistory[]
  comments      Comment[]
  reviews       Review[]
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  avatarUrl String? // URL Cloudinary
  bio       String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Novel {
  id                String    @id @default(cuid())
  title             String
  alternativeTitles String    @default("[]") // Simpan JSON string
  slug              String    @unique
  language          String    @default("id") 
  author            String
  publisher         String?
  translator        String?
  originalLanguage  String?
  releaseYear       Int?
  coverUrl          String?   // URL Cloudinary
  description       String?   
  status            String    @default("ONGOING") // ONGOING, COMPLETED, HIATUS
  views             Int       @default(0)
  rank              Int       @default(0)
  totalChapters     Int       @default(0)
  ratingAverage     Float     @default(0.0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  chapters          Chapter[]
  bookmarks         Bookmark[]
  history           ReadingHistory[]
  comments          Comment[]
  reviews           Review[]

  @@index([language])
}

model Chapter {
  id        String   @id @default(cuid())
  novelId   String
  number    Float
  title     String?
  content   String   
  wordCount Int      @default(0)
  createdAt DateTime @default(now())
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  comments  Comment[]
  history   ReadingHistory[]

  @@index([novelId, number])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  novelId   String
  status    String   @default("PLAN") // READING, COMPLETED, PLAN, DROPPED
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
}

model ReadingHistory {
  id                String   @id @default(cuid())
  userId            String
  novelId           String
  lastReadChapterId String
  progress          Float    @default(0.0)
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel             Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapter           Chapter  @relation(fields: [lastReadChapterId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  novelId   String
  chapterId String?
  content   String
  parentId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  novelId   String
  content   String
  rating    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
}